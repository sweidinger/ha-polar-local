  "services": {
    "set_plans": {
      "name": "Set feeding plans",
      "description": "Replaces all plans on the Polar. Each plan rotates the plate to the front 30 min before (thaw) and opens the lid at the given time.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Polar to address (only needed with several)."
        },
        "plans": {
          "name": "Plans",
          "description": "List of {plate: 1-3, time: 'HH:MM', date: optional 'YYYY-MM-DD', duration: minutes, need_thaw: optional bool}. Without date the next occurrence is used."
        }
      }
    },
    "clear_plans": {
      "name": "Clear feeding plans",
      "description": "Removes all plans from the Polar.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Polar to address."
        }
      }
    },
    "feed_now": {
      "name": "Feed now",
      "description": "Opens the lid immediately.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Polar to address."
        },
        "plate": {
          "name": "Plate",
          "description": "Plate 1-3 (default: current)."
        },
        "duration": {
          "name": "Duration",
          "description": "Minutes (default: max. open duration)."
        }
      }
    },
    "stop_feeding": {
      "name": "Stop feeding",
      "description": "Closes the lid.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Polar to address."
        }
      }
    },
    "send_command": {
      "name": "Send raw command",
      "description": "Sends a raw JSON command to the Polar (for experiments, see docs/API.md).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Polar to address."
        },
        "topic": {
          "name": "Topic",
          "description": "Sub-topic: service, config, ota, event or ntp."
        },
        "payload": {
          "name": "Payload",
          "description": "JSON object with at least 'cmd'."
        }
      }
    }
  }
